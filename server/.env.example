# Server Environment Configuration (Railway / Production / Local)

# Port to listen on (Railway dynamically assigns PORT at runtime; 5000 is local fallback)
PORT=5000

# Environment mode ('production' on Railway, 'development' locally)
NODE_ENV=production

# MongoDB Atlas connection string (Never commit real credentials)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# Strong secret key used for signing and verifying JSON Web Tokens
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Gmail account address used by Nodemailer to dispatch OTP verification emails
EMAIL_USER=

# 16-character Google App Password (NOT regular Gmail password)
EMAIL_PASS=

# Allowed frontend origin(s) for CORS (comma-separated if multiple, without trailing slashes)
# In production on Railway: set to your Vercel URL, e.g. https://your-project.vercel.app
# In development: http://localhost:5173
CLIENT_URL=http://localhost:5173
