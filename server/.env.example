# Server Environment Configuration (Render / Railway / Production / Local)

# Port to listen on (Render/Railway dynamically assigns PORT at runtime; 5000 is local fallback)
PORT=5000

# Environment mode ('production' on cloud hosts, 'development' locally)
NODE_ENV=production

# MongoDB Atlas connection string (Never commit real credentials)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# Strong secret key used for signing and verifying JSON Web Tokens
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---------------------------------------------------------------------------------
# EMAIL OTP CONFIGURATION
# ---------------------------------------------------------------------------------
# IMPORTANT NOTE FOR RENDER FREE TIER:
# Render Free tier strictly BLOCKS outbound SMTP ports (25, 465, 587).
# Using Gmail SMTP/Nodemailer directly will hang and cause ETIMEDOUT in production on Render.
#
# OPTION 1: Brevo HTTP REST API (RECOMMENDED for Render Free - 300 free emails/day)
# Get free API key: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your_email@gmail.com
BREVO_SENDER_NAME="Auth Support"

# OPTION 2: Resend HTTP REST API (100 free emails/day)
# Get free API key: https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM="Auth Support <onboarding@resend.dev>"

# OPTION 3: Gmail Nodemailer (Works on Localhost or Paid Render instances)
EMAIL_USER=
EMAIL_PASS=

# Allowed frontend origin(s) for CORS (comma-separated if multiple, without trailing slashes)
# In production: set to your frontend domain (e.g., https://your-app.vercel.app)
# In development: http://localhost:5173
CLIENT_URL=http://localhost:5173

